# =============================================================
# Orixios — متغيرات البيئة
# انسخ هذا الملف إلى .env عند الحاجة. لا تضع هنا قيمًا حقيقية
# لأي مفاتيح، ولا تلتزم مفاتيح فعلية في نظام التحكم بالإصدارات.
# =============================================================

# اتصال قاعدة البيانات (بنية PostgreSQL + Drizzle التحتية).
# لا توجد جداول مستخدمة في مرحلة Core Tutor Chat الحالية.
DATABASE_URL=postgresql://user:password@localhost:5432/orixios

# وضع الاختبار التطويري:
# - القيمة الافتراضية "false": لا يستخدم النظام أي مفتاح بيئي تلقائيًا،
#   ويعتمد مسار الطالب على مفاتيح المستخدمين فقط.
# - عند "true": يصبح بالإمكان استخدام مفتاح التطوير أدناه، وفقط عبر
#   الخيار الصريح "allowDevEnvironmentFallback" في طبقة اختيار المفاتيح.
#   لا يستخدم مسار الطالب (/api/tutor) هذا المفتاح تلقائيًا أبدًا.
DEV_TESTING_MODE=false

# مفتاح تطوير محلي لـ Gemini.
# يُقرأ فقط عندما يكون DEV_TESTING_MODE=true ومع الخيار الصريح المذكور،
# ولا يُستخدم تلقائيًا عندما تكون DEV_TESTING_MODE=false.
# مخصص للتطوير فقط — لا تضع هنا مفتاحًا حقيقيًا.
GEMINI_API_KEY=
